  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0176" xml:lang="de">
          <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00528/" ed="1r" type="sheet"/>
            <div type="letter_message" hand="#type_black_hansen">
              <opener>
                <seg hand="#print_ORF">
                  <orgName>
                    <lb/><rs type="org" ref="#amp_organization_88">ORF
                    <lb/>ÖSTERREICHISCHER RUNDFUNK</rs>
                  </orgName>
                 </seg>
                <seg hand="#print_ORF">
                  <lb/><rs type="org" ref="#amp_organization_88">Österreichischer Rundfunk, Gesellschaft m. b. H.</rs>, 1041 <rs type="place" ref="#amp_place_id_1">Wien</rs>, Postfach 700
                </seg>
                <seg hand="#print_ORF">
                  <placeName>
                    <address>
                      <lb/><rs type="place" ref="#amp_place_id_635">1041 Wien, Argentinierstraße 22</rs>
                    </address>
                  </placeName>
                      <lb/>Telefon: (0222) 65 37 94
                      <lb/>Fernschreiber: 01/1801
                      <lb/>Telegrammadresse: Rundfunk Wien
                </seg>
                <seg>
                  <persName>
                    <lb/>Herrn
                    <lb/><rs type="person" ref="#amp_person_1">W.H. Auden</rs>
                  </persName>
                  <placeName>
                    <address>
                      <lb/><rs type="place" ref="#amp_place_id_2">Hinterholz 6
                      <lb/><add hand="#type_black_hansen" place="left">3062-</add> <hi rend="underline" hand="#type_black_hansen">Kirchstetten</hi>
                      <lb/><hi rend="underline" hand="#type_black_hansen">Bez.St.Pölten/NÖ</hi></rs>
                    </address>
                  </placeName>
                </seg>
                <seg>
                  <lb/><space quantity="44" unit="char"/>FP 7
                </seg>
                <seg hand="#print_ORF">
                  <lb/>Unser Zeichen<space quantity="2" unit="char"/><rs type="place" ref="#amp_place_id_1">Wien</rs>, den
                </seg>
                <seg>
                  <lb/><space quantity="44" unit="char"/>HL/Dr.G<space quantity="3" unit="char"/>4.9.l970
                </seg>
                <salute>
                  <lb/>Sehr geehrter Herr <rs type="person" ref="#amp_person_1">Auden</rs><space quantity="1" unit="char"/>!
                </salute>
              </opener>
              <p>
                <lb/>Aus dem Programm der <rs type="org" ref="#amp_organization_9">Österreichischen Gesellschaft
                <lb/>für Literatur</rs> ersehe ich, daß Sie am <rs type="event" ref="#amp_event_id_120">29. September
                <lb/>in der Literatur-Gesellschaft sprechen werden</rs>. Ich
                <lb/>möchte diese Gelegenheit benützen, wieder den
                <lb/>Kontakt mit Ihnen aufzunehmen, vor allem um das
                <lb/>eine oder andere Mißverständnis in einem Gespräch
                <lb/>zu beseitigen.
              </p>
              <p>
                <lb/>Wäre es möglich, daß Sie am 29.September schon zu
                <lb/>Mittag nach <rs type="place" ref="#amp_place_id_1">Wien kommen</rs>, damit wir eventuell gemeinsam
                <lb/>Mittagessen können? Vielleicht haben Sie auch Lust,
                <lb/>den Nachmittag in meiner Gesellschaft zu verbringen.
              </p>
              <closer>
                <salute>
                  <lb/>Mit der Bitte um eine kurze Nachricht bin ich
                </salute>
                <salute>
                  <lb/><space quantity="32" unit="char"/>Ihr
                </salute>
                <signed hand="#hand_blue_hansen">
                  <lb/><rs type="person" ref="#amp_person_636"><unclear>Fr.</unclear> <unclear>A.</unclear> Hansen <unclear>Löve</unclear></rs>
                </signed>
                <signed>
                  <lb/><space quantity="31" unit="char"/>HAUPTABTEILUNG KULTUR
                  <lb/><space quantity="31" unit="char"/>(<rs type="person" ref="#amp_person_636">Prof.F.Hansen-Löve</rs>)
                </signed>
              </closer>
             </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00529/" ed="1v" type="sheet"/>
            <div>
              <ab hand="#hand_blue_unident_0176">
                <lb/>70
               </ab>
             </div>
          </div>
      </div>
    </body>
