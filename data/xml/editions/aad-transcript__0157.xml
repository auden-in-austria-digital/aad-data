  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0157" xml:lang="de">
        <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00483/" ed="1r" type="sheet"/>
          <div type="letter_message" hand="#type_black_bachmann" xml:lang="de">
            <opener>
              <seg hand="#print_black_bachmann">
                <lb/>RECHTSANWALT
                <lb/><persName><rs type="person" ref="#amp_person_241">D<hi rend="superscript">R.</hi> PAUL BACHMANN</rs></persName>
                <lb/><placeName><address><rs type="place" ref="#amp_place_id_551">1O1O WIEN I, OPERNRING 8</rs></address></placeName>
                <lb/>FERNRUF 52 87 O1 U. 52 87 O2
                <lb/><rs type="org" ref="#amp_organization_275">SCHELHAMMER &amp; SCHATTERA</rs> <rs type="place" ref="#amp_place_id_1">WIEN</rs>
                <lb/>KONTO NR. 14.217
                <lb/><rs type="org" ref="#amp_organization_276">POSTSPARKASSE</rs> <rs type="place" ref="#amp_place_id_1">WIEN</rs> 121.O43
              </seg>
              <dateline>  
                <date>
                  <lb/><space unit="char" quantity="43"/><rs type="place" ref="#amp_place_id_1">Wien</rs>, am l6.8.l972
                  <lb/>
                </date>
              </dateline>
              <seg>
                <persName>
                  <lb/><space unit="char" quantity="30"/>Herrn 
                  <lb/><space unit="char" quantity="30"/><rs type="person" ref="#amp_person_1">Prof.Wystan Hugh A u d e n</rs>
                </persName>
                <placeName>
                  <address>
                    <lb/><space unit="char" quantity="30"/><rs type="place" ref="#amp_place_id_2">Hinterholz 6
                    <lb/><space unit="char" quantity="30"/>3062 Kirchstetten</rs>
                  </address>
                </placeName>
              </seg>
              <seg>
                <lb/>Betr.: <hi rend="underline" hand="#type_black_bachmann"><rs type="person" ref="#amp_person_1">Prof.Wystan Hugh Auden</rs> -<subst><del rend="erased" hand="#type_black_bachmann">m</del><add place="superimposed" hand="#type_black_bachmann">E</add></subst>xpensen</hi>
              </seg>
              <salute>
                <lb/>Sehr geehrter <rs type="person" ref="#amp_person_1">Herr Professor</rs>!
              </salute>
            </opener>
            <p>
              <lb/>Die gefertigte <rs type="org" ref="#amp_organization_344">Kanzlei</rs> erlaubt sich d<subst><del rend="erased" hand="#type_black_bachmann">e</del><add place="superimposed" hand="#type_black_bachmann">i</add></subst>e Kosten ihrer Mühe-
              <lb/>waltung für die Beratung und Vertretung bei der Durchführung<del rend="erased" hand="#type_black_bachmann">$</del>
              <lb/>eines <rs ana="#ana_136">Schenkungsvertrages</rs> für die Zeit vom 2l.4.l97l bis 7.8.l972
              <lb/>ausschließlich des Verfahrens vor dem <rs type="org" ref="#amp_organization_309">Verwaltungsgerichtshof</rs>
              <lb/>und aller mit diesem Verfahren zusammenhängenden Nebenleistungen
              <lb/>wie folgt zu verrechnen:
            </p>
            <p>
              <lb/>3 Konferenzen 5/2 Std.
              <lb/>9 Telefonate
              <lb/>28 Schreiben
              <lb/>2 Kommissionen 4/2 Std
              <lb/>2 Einstellungsanträge
              <lb/>1 Grundbuchsgesuch
              <lb/>Verdienst: ...................................... S l0.480,--
              <lb/>5,5% USt <space unit="char" quantity="1"/>....................................... "<space unit="char" quantity="4"/>576,40
              <lb/>Barauslagen ..................................... <hi rend="underline" hand="#type_black_bachmann">"<space unit="char" quantity="4"/>499,--<space unit="char" quantity="1"/></hi>
              <lb/>zusammen ........................................ S ll.555,40
            </p>
            <p>
              <lb/>Unter Anschluß eines Erlagscheines wird um Überweisung obigen<del rend="erased" hand="#type_black_bachmann">$</del>
              <lb/>Betrages auf das Konto l4.708 beim <rs type="org" ref="#amp_organization_275">Bankhaus Schelhammer &amp; Schattera</rs>
              <lb/>höflichst gebeten.
            </p>
            <closer>
              <salute>
                <lb/><space quantity="31" unit="char"/>Mit vorzüglicher Hochachtung
              </salute>
              <signed hand="#hand_blue_unident_0157">
                <lb/><unclear>E.</unclear> <gap reason="illegible" unit="char" atLeast="2" atMost="3"></gap>öger
              </signed>
              <signed hand="#type_black_bachmann">
                <lb/><space unit="char" quantity="33"/>für die <rs type="org" ref="#amp_organization_344">Kanzlei</rs>
              </signed>            
            </closer>
           </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00484/" ed="1v" type="sheet"/>
      </div>
     </div>
    </body>
  </text>
