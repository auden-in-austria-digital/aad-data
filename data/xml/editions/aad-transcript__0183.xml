  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0183" xml:lang="de">
          <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00552/" ed="1r" type="sheet"/>
            <div type="letter_message" hand="#type_black_kraus">
              <opener>
                <seg>
                    <lb/>Herrn
                  <persName>
                    <lb/><rs type="person" ref="#amp_person_1">W.H.Auden</rs>
                  </persName>
                  <placeName>
                    <address>
                      <lb/><rs type="place" ref="#amp_place_id_2">Hinterholz 6
                      <lb/>3062 Kirchstetten</rs>
                    </address>
                  </placeName>
                </seg>
                <seg hand="#print_black_ev">
                  <orgName>
                    <lb/><rs type="org" ref="#amp_organization_26">EV</rs>
                  </orgName>
                </seg>
                <seg hand="#print_black_ev">
                  <orgName>
                    <lb/><rs type="org" ref="#amp_organization_26">Europaverlag</rs>
                  </orgName>
                  <placeName>
                    <lb/><rs type="place" ref="#amp_place_id_1">Wien</rs>
                    <lb/><rs type="place" ref="#amp_place_id_26">München</rs>
                    <lb/><rs type="place" ref="#amp_place_id_503">Zürich</rs>
                  </placeName>
                </seg>
                <seg hand="#print_black_ev">
                  <orgName>
                    <lb/><rs type="org" ref="#amp_organization_26">Europa Verlags-A.G.</rs>
                  </orgName>
                  <placeName>
                  <address>
                    <lb/><rs type="place" ref="#amp_place_id_805">Altmannsdorfer
                    <lb/>Straße 154-156
                    <lb/>A-1232 Wien</rs>
                  </address> 
                  </placeName>
                    <lb/>Telefon
                    <lb/>(0 222) 67 26 22
                    <lb/>Telex Nr. 01-326
                </seg>
                <dateline>  
                  <date>
                    <lb/><space unit="char" quantity="30"/><rs type="place" ref="#amp_place_id_1">Wien</rs>, 26.Mai l972
                  </date>
                </dateline>
                <salute>
                  <lb/>Lieber <rs type="person" ref="#amp_person_1">Herr Auden</rs>,
                </salute>
              </opener>
              <p>
                <lb/>es hat mich sehr gefreut, Sie wiederzusehen und mit
                <lb/>Ihnen den geplanten <rs type="lit_work" ref="#lit_work_id_67">Lyrik-Band durchgesprochen</rs> zu haben.
                <lb/>Ich hoffe, von Ihrem Agenten nun bald Nachricht zu be-
                <lb/>kommen. Wie vereinbart<unclear><add hand="#hand_black_kraus" place="inline">,</add></unclear> schicke ich Ihnen beiliegend die
                <lb/>bereits vorliegenden Übersetzungen und wäre Ihnen dank-
                <lb/>bar, wenn Sie sie genau durchsehen wollten. Weitere
                <lb/>werden demnächst folgen.
              </p>
              <closer>
                <lb/>Ich wünsche Ihnen eine gute und produktive Zeit und bin 
                <lb/><salute>mit den herzlichsten Grüssen</salute>
                <salute>
                  <lb/><space unit="char" quantity="30"/>Ihr
                </salute>
                <signed hand="#hand_black_kraus">
                  <lb/><rs type="person" ref="#amp_person_137">Wolfgang Kraus</rs>
                </signed>
                <signed>
                  <lb/><space unit="char" quantity="21"/>(<rs type="person" ref="#amp_person_137">Dr.Wolfgang Kraus</rs>)
                </signed>
              </closer>
                <postscript>
                  <ab>
                    <lb/>P.S.Beiliegend die Fotokopie eines Briefes der <rs type="org" ref="#amp_organization_515">Linder AG</rs>
                    <lb/><space unit="char" quantity="4"/>und <rs type="org" ref="#amp_organization_26">unsere</rs> Antwort darauf.
                  </ab>
                </postscript>
            </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00553/" ed="1v" type="sheet"/>
      </div>
     </div>
    </body>
  </text>
