  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0169" xml:lang="en">
          <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00511/" ed="1r" type="sheet"/>
            <div type="letter_message" hand="#type_black_epstein">
              <opener>
                <seg hand="#print_NYRB">
                  <orgName>
                    <lb/><rs type="org" ref="#amp_organization_362">The New York Review of Books</rs>
                  </orgName>
                  <placeName>
                    <lb/>250 West Fifty-Seventh Street
                    <lb/><rs type="place" ref="#amp_place_id_28">New York City</rs>, New York 10019
                    <lb/>PLaza 7-8070
                  </placeName>
                </seg>
                <dateline>  
                  <date>
                    <lb/><space quantity="26" unit="char"/>April l7, l967
                  </date>
                </dateline>
                <seg>
                  <persName>
                    <lb/><rs type="person" ref="#amp_person_1">W.H. Auden</rs>
                  </persName>
                  <placeName>
                    <address>
                      <lb/><rs type="place" ref="#amp_place_id_2">Kirchstetten (<foreign xml:lang="de">Westbahn</foreign>)
                      <lb/>Hinterholz 6 
                      <lb/><rs type="place" ref="#amp_place_id_6"><foreign xml:lang="de">N-<unclear>Ö</unclear></foreign></rs>
                      <lb/><rs type="place" ref="#amp_place_id_10">Austria</rs></rs>
                    </address>
                  </placeName>
                </seg>
                <salute>
                  <lb/>Dear <rs type="person" ref="#amp_person_1">Wyston</rs>:
                </salute>
              </opener>
              <p>
                <lb/><space quantity="5" unit="char"/>I<subst><del rend="erased" hand="#type_black_epstein"><gap reason="illegible" quantity="1" unit="char"></gap></del><add place="superimposed" hand="#type_black_epstein"><unclear>'</unclear></add></subst>ve just sent the <rs type="person" ref="#amp_person_556">Bonhoffer</rs> books I
                <lb/>told you about.<space quantity="2" unit="char"/>The personal one especially
                <lb/>looks awfully interesting.<space quantity="2" unit="char"/>But anything from
                <lb/>you on this would be great.
              </p>
              <p>
                <lb/><space quantity="5" unit="char"/>I trust all is well.<space quantity="2" unit="char"/>Love to <rs type="person" ref="#amp_person_4">Chester</rs>.
              </p>
              <closer>
                <salute>
                  <lb/><space quantity="25" unit="char"/>As ever,
                </salute>
                <signed hand="#hand_gray_epstein">
                  <lb/><rs type="person" ref="#amp_person_555">Barbara</rs>
                </signed>
                <signed>
                  <lb/><space quantity="25" unit="char"/><rs type="person" ref="#amp_person_555">Barbara Epstein</rs>
                </signed>
              </closer>
              <postscript>
                 <p>
                   <lb/>BE/ab
                 </p>
              </postscript>
             </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00512/" ed="1v" type="sheet"/>
            <div>
              <ab hand="#hand_blue_unident_0169">
                <lb/>45
              </ab>
            </div>
         </div>
      </div>
    </body>
