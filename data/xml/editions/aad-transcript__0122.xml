    <body>
      <div type="transcription" xml:id="transcription_aad_0122">
        <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00403/" ed="1r" type="sheet"/>
          <div type="letter_message" hand="#type_black_urbach" xml:lang="de">
          <opener>
            <seg hand="#print_black_oegfl">
              <orgName>
                <lb/><rs type="org" ref="#amp_organization_9">ÖSTERREICHISCHE GESELLSCHAFT FÜR LITERATUR</rs>
              </orgName>
              <lb/><placeName><rs type="place" ref="#amp_place_id_177">PALAIS WILCZEK, 1O1O WIEN I, HERRENGASSE 5</rs></placeName> TEL. 63 81 59, 63 08 64
            </seg>
            <persName>
              <lb/><rs type="person" ref="#amp_person_1">Herrn
              <lb/>W.H.Auden</rs>
            </persName>
            <placeName>
              <address>
                <lb/><rs type="place" ref="#amp_place_id_2">3062 Kirchstetten
                <lb/>Hinterholz 6</rs>
              </address>
            </placeName>
            <lb/><dateline><space unit="char" quantity="40"/><rs type="place" ref="#amp_place_id_1">Wien</rs>, <date>11.August 1970</date></dateline>  
            <salute>
              <lb/>Sehr verehrter <rs type="person" ref="#amp_person_1">Herr Auden</rs>!
            </salute>
          </opener>
          <p>
            <lb/>Im Namen von <rs type="person" ref="#amp_person_137">Dr.Kraus</rs> möchte ich Ihnen sehr herzlich für Ihren
            <lb/>Brief danken. Wir haben hier "<rs type="lit_work" ref="#lit_work_id_134">About the house</rs>" und würden uns
            <lb/>sehr freuen, wenn Sie uns "<rs type="lit_work" ref="#lit_work_id_137">City without walls</rs>" für kurze Zeit
            <lb/>zur Verfügung stellen könnten. Vielleicht könnten Sie auch an-
            <lb/>streichen, welche Gedichte aus den <rs type="lit_work" ref="#lit_work_id_134 #lit_work_id_137">beiden Bänden</rs> Sie übersetzt
            <lb/>haben wollen. Es genügt natürlich, wenn Sie uns den Band mit der
            <lb/>Post schicken. Wir wollen Ihnen mit einer Reise nach <rs type="place" ref="#amp_place_id_1">Wien</rs> keine
            <lb/>Unannehmlichkeiten machen.
          </p>
          <closer>
            <salute>
            <lb/><space unit="char" quantity="35"/>Mit herzlichen Grüßen
            </salute>
            <salute hand="#hand_blue_urbach">
              <lb/>Ihr
              </salute>
            <signed hand="#hand_blue_urbach">
              <lb/><rs type="person" ref="#amp_person_284">Reinhard Urbach</rs>
            </signed>
              <signed>
                <lb/><space unit="char" quantity="38"/>(<rs type="person" ref="#amp_person_284">Reinhard Urbach</rs>)
              </signed>
          </closer>
        </div>          
          <div type="letter_message" hand="#hand_blue_auden" xml:lang="de">
          <opener>
            <salute>
              <lb/>Sehr <del hand="#hand_blue_auden" rend="overstrike">ge</del> verehrter <rs type="person" ref="#amp_person_284">Herr Urbach</rs>:
            </salute>
           </opener>
            <p>
              <lb/>Hiermit die <rs type="lit_work" ref="#lit_work_id_137 #lit_work_id_135">Büche</rs> und
            <lb/>ein List
          </p>
          <closer>
            <signed>
              <lb/><rs type="person" ref="#amp_person_1">W.H. Auden</rs>
            </signed>
          </closer>
            </div>
      <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00404/" ed="1v" type="sheet"/>
      <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00401/" ed="2r" type="sheet"/>
          <div type="enclosure" hand="#type_black_auden">
            <div type="prose" xml:lang="en">
        <opener hand="#print_black_auden">
          <placeName xml:lang="de">
            <lb/><rs type="place" ref="#amp_place_id_2">3062 KIRCHSTETTEN
            <lb/>BEZ. ST. PÖLTEN
            <lb/>HINTERHOLZ 6
              <lb/>N.-Ö., <foreign xml:lang="en">AUSTRIA</foreign></rs>
          </placeName>
        </opener>
          </div>
          <div>
            <ab hand="#hand_gray_oegfl">
            <lb/>A-2 Auden  
            </ab>
          </div>
          <div type="prose" hand="#type_black_auden">
        <ab>
          <lb/>From <hi rend="underline" hand="#type_black_auden"><rs type="lit_work" ref="#lit_work_id_134">ABOUT THE HOUSE</rs></hi>
          <lb xml:id="list_element_1"/><space quantity="4" unit="char"/><rs type="lit_work" ref="#lit_work_id_37">The Cave of Making</rs><space quantity="3" unit="char"/> (p 8-II<subst><del rend="overtyped" hand="#type_black_auden">*</del><add place="superimposed" hand="#type_black_auden">)</add></subst>
        </ab>
        <ab>
          <add place="left" corresp="#list_element_1" hand="#hand_gray_unident_0122_01">-</add>
        </ab>
        <ab>
           <lb/>from <hi rend="underline" hand="#type_black_auden"><rs type="lit_work" ref="#lit_work_id_137">CITY WITHOUT WALLS</rs></hi>
            <lb xml:id="list_element_2"/><space quantity="1" unit="char"/><rs type="lit_work" ref="#lit_work_id_107">In Memoriam Emma Eiermann</rs>/<space quantity="3" unit="char"/>(p 2I-23) <add hand="#hand_gray_unident_0122_02" place="right">no <unclear>Transl</unclear></add>
            <lb xml:id="list_element_3"/><space quantity="1" unit="char"/><rs type="lit_work" ref="#lit_work_id_38">Prologue at Sixty</rs><space quantity="14" unit="char"/>(p II7-I2I)
          </ab>
            <ab>
              <add place="left" corresp="#list_element_2" hand="#hand_gray_unident_0122_01">-</add>
            </ab>
            <ab>
              <add place="left" corresp="#list_element_3" hand="#hand_gray_unident_0122_01">-</add>
            </ab>
         <ab> 
           <lb/><hi rend="underline" hand="#type_black_auden">From <del rend="overtyped" hand="#type_black_auden">Collected S </del><space quantity="1" unit="char"/><rs type="lit_work" ref="#lit_work_id_135">COLLECTED SHORTER POEMS</rs></hi>
           <lb xml:id="list_element_4"/><space quantity="1" unit="char"/><rs type="lit_work" ref="#lit_work_id_324">In Praise of Limestone</rs><space quantity="7" unit="char"/>(p 238-24I)
         </ab>
            <ab xml:lang="de">
              <add place="left" corresp="#list_element_4" hand="#hand_gray_unident_0122_02">nein</add>
            </ab>
            <ab>
              <lb/><space quantity="13" unit="char"/>____
            </ab>
            
          <ab>
            <lb/><hi rend="underline" hand="#type_black_auden">Unpublished<subst><del hand="#type_black_auden" rend="overtyped">.</del><add hand="#type_black_auden" place="inline"> </add></subst>in book form.</hi>
            <lb xml:id="list_element_5"/><space quantity="2" unit="char"/><rs type="lit_work" ref="#lit_work_id_325">Old People's Home</rs> (enclosed)
          </ab>
            <ab xml:lang="de">
              <add place="left" corresp="#list_element_5" hand="#hand_gray_unident_0122_02">nein</add>
            </ab>
        </div>
      <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00402/" ed="2v" type="sheet"/>
