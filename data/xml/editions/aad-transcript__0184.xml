  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0184" xml:lang="en">
          <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00554/" ed="1r" type="card"/>
            <div type="letter_message" hand="#hand_blue_kyrou">
              <opener>
                <salute>
                  <lb/>Dear <rs type="person" ref="#amp_person_1">Mr. Auden</rs>-
                </salute>
              </opener>
              <p>
                <lb/>This small selection of
                <lb/>your poetry, transplanted
                <lb/>into greek, includes:
              </p>
              <p>
                <lb/>1. Who's Who
                <lb/>2. O what is that sound which
                <lb/>so thrills the ear
                <lb/>3. Epitaph on a Tyrant
                <lb/>4. Rimbaud
                <lb/>5. Say this city has 10.000.000 souls
                <lb/>&#42; 6. These are stirring times for 
                <lb/>the editors of newspapers
                <lb/>&#42; 7. Herod
                <lb/>&#42; 8. Well, so that is that. Now
                <lb/>we must dismantle the Tree
                <lb/>The Unknown Citizen.
              </p>
              <closer>
                <salute>
                  <lb/>With best regards
                </salute>
                <signed>
                  <lb/><gap reason="illegible" unit="char" atLeast="5" atMost="7"></gap>
                </signed>
              </closer>
              <dateline>
                <date>
                  <lb/>Aug<unclear>.</unclear> 13<unclear>.</unclear>1973
                </date>
              </dateline>
              <postscript>
                <ab>
                  <lb/>&#42; From "For the Time Being"
                </ab>
              </postscript>
            </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00555/" ed="1v" type="card"/>
            <div>
              <ab hand="#hand_blue_unident_0184">
                <lb/>85
              </ab>
              <ab hand="#print_black_kyrou">
                <lb/>ΚΛΕΙΤΟΣ Σ. ΚΥΡΟΥ
              </ab>
              <ab hand="#hand_blue_kyrou">
                <lb/>KLITOS S. KYROU
              </ab>
              <ab hand="#hand_blue_kyrou">
                <lb/>VAS. OLGA AVE. 85
              </ab>
              <ab hand="#print_black_kyrou">
                <lb/>ΒΑΣ. ΟΛΓΑΣ 85
                <lb/>THΛ. 832.919
              </ab>
              <ab hand="#hand_blue_kyrou">
                <lb/>THESSALONIKI
              </ab>
              <ab hand="#print_black_kyrou">
                <lb/>ΘΕΣΣΑΛΟΝΙΚΗ
              </ab>
            </div>
          </div>
