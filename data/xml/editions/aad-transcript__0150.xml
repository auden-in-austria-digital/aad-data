  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0150" xml:lang="de">
        <div type="envelope">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00616/" ed="1r" type="envelope"/>
          <ab hand="#hand_blue_auden">
            <lb/><del rend="overstrike" hand="#hand_blue_auden"><gap unit="char" atLeast="1" atMost="3" reason="illegible"></gap></del>
          </ab>
          <ab hand="#hand_blue_auden">
            <lb/><rs type="person" ref="#amp_person_220">Fr<unclear>a</unclear>ulein
            <lb/>Herta. F. Staub</rs>
            <address>
              <lb/><rs type="place" ref="#amp_place_id_417">Wien VIII
              <lb/>Schönborngasse 6.</rs>
            </address>   
          </ab>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00617/" ed="1v" type="envelope"/>
          <ab hand="#print_black_auden">
            <lb/><rs type="person" ref="#amp_person_1">W. H. AUDEN</rs>
              <address>
                <lb/><rs type="place" ref="#amp_place_id_2">KIRCHSTETTEN (WESTBAHN)
                <lb/>HINTERHOLZ 6
                <lb/>N.-Ö., <foreign xml:lang="en">AUSTRIA</foreign></rs>
              </address>
          </ab>
          <ab hand="#stamp_gray_wsl">
            <lb/><rs type="org" ref="#amp_organization_240">ENER STADT- U. LAND</rs>
          </ab>
        </div>
        <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00618/" ed="2r" type="sheet"/>
          <div type="letter_message" hand="#hand_blue_auden">
            <opener>
              <seg hand="#print_black_auden">
                <persName>
                  <lb/><rs type="person" ref="#amp_person_1">W. H. Auden</rs>
                </persName>
              </seg>
              <seg hand="#print_black_auden">
                <placeName>
                   <address>
                     <lb/><rs type="place" ref="#amp_place_id_2">KIRCHSTETTEN (WESTBAHN)
                     <lb/>HINTERHOLZ 6
                     <lb/>N.-Ö., <foreign xml:lang="en">AUSTRIA</foreign></rs>
                    </address>
                  </placeName>
                </seg>
              <salute hand="#hand_blue_auden">
                <lb/>L<subst><del rend="overwritten" hand="#hand_blue_auden">e</del><add place="superimposed" hand="#hand_blue_auden">i</add></subst>ebe <rs type="person" ref="#amp_person_220">Fraul<unclear>ei</unclear>n Staub</rs>:
              </salute>
            </opener>
            <p>
              <lb/>Wunderbar! Bitte, nehmen den Zug
              <lb/>der fährt ab von <rs type="place" ref="#amp_place_id_309">Westbahnhof</rs> am 14<unclear>&#8231;</unclear>10.
              <lb/>Ich will <add hand="#hand_blue_auden" place="above">Ihnen</add> am <rs type="place" ref="#amp_place_id_517">Kirchstetten Bahnhof</rs> mit Auto
              <lb/>erwarten.
            </p>
            <closer>
              <signed>
                <lb/><rs type="person" ref="#amp_person_1">Wystan Auden</rs>
              </signed>
            </closer>
          </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00619/" ed="2v" type="sheet"/>
          <div>
            <ab hand="#stamp_gray_wsl">
              <lb/><rs type="org" ref="#amp_organization_240">WIENER STADT- U. LANDESBIBL.</rs> <space quantity="1" unit="char"/>4
            </ab>
          </div>
        </div>
      </div>
    </body>
