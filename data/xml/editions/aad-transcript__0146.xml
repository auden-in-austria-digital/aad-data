  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0146" xml:lang="de">
        <div type="envelope" hand="#type_black_auden">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00590/" ed="1r" type="envelope"/>
          <ab xml:lang="en">
            <lb/><rs type="person" ref="#amp_person_1">W.H.Auden</rs><space quantity="15" unit="char"/><del rend="overtyped" hand="#type_black_auden"><hi rend="underline" hand="#type_black_auden"><foreign xml:lang="de">mit Luft-Po</foreign></hi></del><hi rend="underline" hand="#type_black_auden">AIR-MAIL</hi>
            <address>
                <lb/><rs type="place" ref="#amp_place_id_29">77 St Mark's Place
                <lb/>New York City 3
                <lb/>New York
                <lb/>U.S.A.</rs>
            </address>
          </ab>
          <ab xml:lang="de">
                <lb/><space quantity="23" unit="char"/><rs type="person" ref="#amp_person_433">Dr Felix Braun</rs>
              <address>
                <lb/><space quantity="24" unit="char"/><rs type="place" ref="#amp_place_id_515">WIEN XIX
                <lb/><space quantity="26" unit="char"/>Geistingergasse I
                <lb/><space quantity="28" unit="char"/><foreign xml:lang="en">Austria</foreign></rs>
            </address>   
          </ab>
          <ab hand="#hand_red_wsb" xml:lang="de">
            <lb/><unclear>zu</unclear> I.N. 198.190
          </ab>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00591/" ed="1v" type="envelope"/>
          <div xml:lang="de">
            <ab hand="#stamp_blue_wsb">
              <lb/><rs type="org" ref="#amp_organization_241">WIENER STADTBIBLIOTHEK</rs>
            </ab>
          </div>
          </div>
          <div type="letter" xml:lang="de">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00592/" ed="2r" type="sheet"/>
            <div>
              <ab hand="#hand_red_wsb">
                <lb/>I.N.198.190
              </ab>
             </div>
            <div type="letter_message" hand="#type_black_auden">
              <opener>
                <dateline xml:lang="en">
                  <placeName>
                    <address>
                      <lb/><rs type="place" ref="#amp_place_id_29">77 St Mark's Place
                      <lb/>New York City 3
                      <lb/>New York</rs>
                    </address>
                  </placeName>
                  <date>
                    <lb/><space quantity="38" unit="char"/><del rend="overtyped" hand="#type_black_auden">Okt</del> Nov 3rd,
                  </date>
                </dateline>
                <salute>
                  <lb/><space quantity="23" unit="char"/><del rend="overtyped" hand="#type_black_auden">Libe</del> Lieber <rs type="person" ref="#amp_person_433">Dr Felix Braun</rs>:
                </salute>
              </opener>
              <p>
                <lb/><space quantity="15" unit="char"/>Ich <del rend="overtyped" hand="#type_black_auden">shickeS</del> schicke Ihnen mit Buch-Post ei<subst><del rend="overtyped" hand="#type_black_auden">e</del><add place="superimposed" hand="#type_black_auden">n</add></subst>en untergeschriebenen
                <lb/><space quantity="10" unit="char"/>Exemplar von <rs type="lit_work" ref="#lit_work_id_330"><foreign xml:lang="en">The Shield of Achilles</foreign></rs>. Es ist ein Gesch<g ref="#uml_a_lc_tt">ä</g>nk von
                <lb/><space quantity="10" unit="char"/><rs type="person" ref="#amp_person_434">Peter Branscombe</rs> der hat mir gefragt ob ich es tun w<g ref="#uml_u_lc_tt">ü</g>rde.
              </p>
              <p>
                <lb/><space quantity="12" unit="char"/>Selbverst<g ref="#uml_a_lc_tt">ä</g>n<subst><del rend="overtyped" hand="#type_black_auden">g</del><add place="superimposed" hand="#type_black_auden">d</add></subst>lig <space quantity="1" unit="char"/>ich bin sehr froh.
              </p>
              <p>
                <lb/><space quantity="11" unit="char"/>Jezt habe ich ein <rs type="place" ref="#amp_place_id_2">Haus in Kirchstetten</rs> verkauft und bin sehr
                <lb/><space quantity="11" unit="char"/>zufrieden damit.
              </p>
              <p>
                <lb/><space quantity="15" unit="char"/>Hoffentlich,<del rend="overtyped" hand="#type_black_auden">nacshtes</del> n<g ref="#uml_a_lc_tt">ä</g>chstes Sommer wenn ich ruzuckkehre,k<g ref="#uml_o_lc_tt">ö</g>nnen
                <lb/><space quantity="11" unit="char"/>Sie herauskommen <unclear>f</unclear><g ref="#uml_u_lc_tt">ü</g>r <del rend="overtyped" hand="#type_black_auden">eien</del> ein Besuch.
              </p>
              <closer>
                <salute>
                  <lb/><space quantity="24" unit="char"/>mit herzlichen Grusse
                </salute>
                <signed hand="#hand_blue_auden">
                  <lb/><rs type="person" ref="#amp_person_1">Wystan Auden</rs>
                </signed>
                <signed hand="#type_black_auden">
                  <lb/><space quantity="45" unit="char"/>W.H.<unclear>.</unclear><subst><del rend="overtyped" hand="#type_black_auden"><unclear>Z</unclear></del><add place="superimposed" hand="#type_black_auden">A</add></subst>uden
                </signed>
              </closer>
            </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00593/" ed="2v" type="sheet"/>
            <div>
              <ab hand="#stamp_blue_wsb" xml:lang="de">
                <lb/><rs type="org" ref="#amp_organization_241">WIENER STADTBIBLIOTHEK</rs>
              </ab>
            </div>
           </div>
         </div>
    </body>
  </text>
