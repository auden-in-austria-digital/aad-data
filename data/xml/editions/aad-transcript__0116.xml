  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0116" xml:lang="de">
        <div type="letter">
          <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00389/" ed="1r" type="sheet"/>
          <div type="letter_message" hand="#type_cc_kraus">
            <opener>
              <persName>
                <lb/><rs type="person" ref="#amp_person_137">Dr. Wolfgang Kraus</rs>
              </persName>
              <address>
                  <lb/><rs type="place" ref="#amp_place_id_423">Berggasse 6/9
                  <lb/>1090 Wien</rs>
              </address>
              <persName>
                <lb/><rs type="person" ref="#amp_person_1">Herrn
                <lb/>W. H. Auden</rs>
              </persName>
              <address>
                <lb/><rs type="place" ref="#amp_place_id_2">Hinterholz 6
                <lb/>3062 Kirchstetten</rs></address><space unit="char" quantity="22"/><dateline><placeName><rs type="place" ref="#amp_place_id_1">Wien</rs></placeName>, <date>6. August 1973</date></dateline>
              <salute>
                <lb/>Lieber <rs type="person" ref="#amp_person_1">Herr Auden</rs>,
              </salute>         
            </opener>
              <p>
                <lb/><space unit="char" quantity="5"/>mein Freund <rs type="person" ref="#amp_person_320">Zbigniew Herbert</rs> wird am Donnerstag, den 9.
                <lb/>und Freitag, den 10. August in <rs type="place" ref="#amp_place_id_1">Wien</rs> sein. Wir würden uns sehr
                <lb/>freuen, wenn wir Sie an einem dieser beiden Tage zum Tee be-
                <lb/>suchen könnten, so etwa um 1/2 5 Uhr. Lassen Sie mich doch
                <lb/>bitte mit einer Zeile wissen, ob und an welchem Tag es Ihnen
                <lb/>recht ist.
              </p>
              <p>
                <lb/><space quantity="5" unit="char"/>Hoffentlich geht es Ihnen trotz der Hitze gut und<subst><del rend="erased" hand="#type_cc_kraus"><gap unit="char" quantity="1" reason="illegible"/></del><add place="superimposed" hand="#type_cc_kraus"><space quantity="1" unit="char"/></add></subst>die
                <lb/>Arbeit gedeiht!
              </p>
              <closer>
                <salute>
                  <lb/><space quantity="5" unit="char"/>Alle guten Wünsche und Grüsse
                </salute>
                <salute>
                  <lb/><space quantity="40" unit="char"/>Ihr
                </salute>
                <signed>
                  <lb/><space quantity="30" unit="char"/>(<rs type="person" ref="#amp_person_137">Dr. Wolfgang Kraus</rs>)
                </signed>
              </closer>
            </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00390/" ed="1v" type="sheet"/>
        </div>
      </div>
    </body>
