  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0158" xml:lang="de">
        <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00485/" ed="1r" type="sheet"/>
          <div type="letter_message" hand="#type_black_bachmann_lawfirm" xml:lang="de">
            <opener>
              <seg hand="#print_black_bachmann">
                <lb/>RECHTSANWALT
                <lb/><persName><rs type="person" ref="#amp_person_241">D<hi rend="superscript">R.</hi> PAUL BACHMANN</rs></persName>
                <lb/><placeName><address><rs type="place" ref="#amp_place_id_551">1O1O WIEN I, OPERNRING 8</rs></address></placeName>
                <lb/>FERNRUF 52 87 O1 U. 52 87 O2
                <lb/><rs type="org" ref="#amp_organization_275">SCHELHAMMER &amp; SCHATTERA</rs> <rs type="place" ref="#amp_place_id_1">WIEN</rs>
                <lb/>KONTO NR. 14.217
                <lb/><rs type="org" ref="#amp_organization_276">POSTSPARKASSE</rs> <rs type="place" ref="#amp_place_id_1">WIEN</rs> 121.O43
              </seg>
              <dateline>  
                <date>
                  <lb/><space unit="char" quantity="38"/><rs type="place" ref="#amp_place_id_1">Wien</rs>,am 4.9.l972
                  <lb/>
                </date>
              </dateline>
              <seg>
                <persName>
                  <lb/><space unit="char" quantity="30"/>Herrn 
                  <lb/><space unit="char" quantity="30"/><rs type="person" ref="#amp_person_1">Prf.Wystan Hugh A u d en</rs>
                </persName>
                <placeName>
                  <address>
                    <lb/><space unit="char" quantity="30"/><rs type="place" ref="#amp_place_id_2">Hinterholz 6
                      <lb/><space unit="char" quantity="30"/>3062 Kirchstetten</rs>
                  </address>
                </placeName>
              </seg>
              <seg>
                <lb/>Betr.: <hi rend="underline" hand="#type_black_bachmann_lawfirm"><rs type="person" ref="#amp_person_1">Prof.Auden</rs> - Verwaltungsgerichtshofbeschwerde</hi>
              </seg>
              <salute>
                <lb/>Sehr geehrter <rs type="person" ref="#amp_person_1">Herr Professor</rs>!
              </salute>
            </opener>
            <p>
              <lb/>Die gefertigte Kanzlei erlaubt sich die Kosten ihrer Mühe-
              <lb/>waltung für die Verfassung einer Verwaltungsgerichtshofbe-
              <lb/>schwerde einschließlich der Nebenleistungen wie Konferenzen,
              <lb/>Telefonate und Kommissionen wie folgt zu verrechnen:
            </p>
            <p>
              <lb/>Verdienst ................................... S 8.l00,--
              <lb/>5,5% USt .................................... "<space unit="char" quantity="4"/>445,50
              <lb/>Barauslagen .................................<hi rend="underline" hand="#type_black_bachmann_lawfirm"><space unit="char" quantity="1"/>"<space unit="char" quantity="4"/>390,--<space unit="char" quantity="1"/></hi>
              <lb/>zusammen ...................................<space unit="char" quantity="2"/>S<space unit="char" quantity="2"/>8.935,50
            </p>
            <p>
              <lb/>Unter Anschluß eines Erlagscheines wird um Überweisung obigen
              <lb/>Betrages auf das Konto l4.708 beim Bankhaus Schelhammer &amp;
              <lb/>Schattera höflichst gebeten.
            </p>
            <closer>
              <salute>
                <lb/><space quantity="28" unit="char"/>Mit vorzüglicher Hochachtung
              </salute>
              <signed hand="#stamp_blue_bachmann">
                <lb/>RECHTSANWALT
                <lb/>Dr. PAUL BACHMANN
                <lb/>1010 WIEN I., OPERNRING 8
                <lb/>FERNRUF 52 87 01 SERIE
                <lb/>POSTSPARKASSE WIEN 121.043
              </signed>
              <signed hand="#type_black_bachmann">
                <lb/><space unit="char" quantity="31"/>für die <rs type="org" ref="#amp_organization_344">Kanzlei</rs>
              </signed>
              <signed hand="#hand_blue_unident_0158_01">
                <lb/>E. <gap reason="illegible" unit="char" atLeast="1" atMost="3"></gap>öger
              </signed>
            </closer>
            <postscript>
              <p>
                <lb/>1 Erlagschein
              </p>
            </postscript>
           </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00486/" ed="1v" type="sheet"/>
          <div>
            <ab hand="#hand_blue_unident_0158_02">
              <lb/><hi rend="underline" hand="#hand_blue_unident_0158_02">Akt<unclear>.</unclear> <gap reason="illegible" unit="char" quantity="1"></gap> 12<subst><del rend="overwritten" hand="#hand_blue_unident_0158_02">3</del><add place="superimposed" hand="#hand_blue_unident_0158_02">7</add></subst><unclear>/</unclear>75</hi>
              <lb/>R<unclear>z</unclear>g. N<gap reason="illegible" unit="char" atLeast="3" atMost="4"></gap>.
            </ab>
          </div>
