  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0162" xml:lang="en">
          <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00493/" ed="1r" type="sheet"/>
            <div type="letter_message" hand="#type_black_boteandbock">
              <opener>
                <seg hand="#print_black_boteandbock" xml:lang="de">
                  <lb/><orgName><rs type="org" ref="#amp_organization_345">BOTE &amp; BOCK</rs></orgName>
                  <lb/><placeName><rs type="place" ref="#amp_place_id_17">BERLIN</rs> &#xB7; <rs type="place" ref="#amp_place_id_292">WIESBADEN</rs></placeName>
                  <lb/>Musik- und Bühnenverlag KG &#xB7; <address><rs type="place" ref="#amp_place_id_556">1 Berlin 12 &#xB7; Hardenbergstraße 9 a &#xB7;</rs></address> Telefon: (03 11) 3 12 30 81
                </seg>
                <seg> hand="#print_black_boteandbock" xml:lang="de">
                  <lb/><hi rend="underline" hand="#print_black_boteandbock"><rs type="org" ref="#amp_organization_345">BOTE &amp; BOCK</rs> &#xB7; <rs type="place" ref="#amp_place_id_556">1 Berlin 12 (Charlbg.) &#xB7; Hardenbergstraße 9 a</rs></hi>
                  <lb/>
                </seg>
                <seg>
                  <persName>
                    <lb/><rs type="person" ref="#amp_person_1">Mr. W. H. Auden</rs>
                  </persName>
                  <placeName>
                    <address>
                      <lb/><rs type="org" ref="#amp_organization_6">Christ Church College</rs> 
                      <lb/><rs type="place" ref="#amp_place_id_46"><hi rend="underline" hand="#type_black_boteandbock">O x f o r d/ENGLAND</hi></rs>
                    </address>
                  </placeName>
                </seg>
                <dateline>  
                  <date>
                    <lb/><space unit="char" quantity="43"/>April 10th, 1973
                    <lb/><space unit="char" quantity="43"/>-/th
                  </date>
                </dateline>
                <salute>
                  <lb/>Dear <rs type="person" ref="#amp_person_1">Sir</rs>,
                </salute>
              </opener>
              <p>
                <lb/>We have been advised by your <rs ana="#ana_141">co-author</rs>, <rs type="person" ref="#amp_person_207">Mr. Nicolas Nabokov</rs>,
                <lb/>that according to the agreement, which you made with him, we
                <lb/>should transfer to your account with your literary agent,
                <lb/><space unit="char" quantity="18"/><rs type="org" ref="#amp_organization_29">Curtis Brown Ltd.</rs>
                <lb/><space unit="char" quantity="18"/>att. <rs type="person" ref="#amp_person_541">Mr. Knowlton</rs>
                <lb/><space unit="char" quantity="18"/><rs type="place" ref="#amp_place_id_555">60 East, 56 Street
                <lb/><space unit="char" quantity="18"/>New York, N.Y. 10022/USA</rs>
                <lb/>one third of his royalties for all past and future perfor-
                <lb/>mances of his opera <rs type="lit_work" ref="#lit_work_id_19">"Love's Labour's Lost"</rs> as well as for
                <lb/>the sale of the <rs type="lit_work" ref="#lit_work_id_20">libretto</rs>.
              </p>
              <p>
                <lb/>If you wish to have these amounts transferred to you directly
                <lb/>or to someone else, please advise us accordingly.
              </p>
              <closer>
                <salute>
                  <lb/><space quantity="27" unit="char"/>Very sincerely yours,
                </salute>
                <signed>
                  <lb/><space quantity="27" unit="char"/><rs type="org" ref="#amp_organization_345">B O T E<space quantity="3" unit="char"/>&amp;<space quantity="3" unit="char"/>B O C K</rs>
                </signed>
                <signed hand="#hand_blue_unident_0162_01">
                  <lb/><unclear>iV.</unclear> Schmidt
                </signed>
                <signed hand="#hand_blue_unident_0162_02">
                  <lb/><gap reason="illegible" quantity="2" unit="char"></gap><gap reason="illegible" unit="char" atLeast="7" atMost="10"></gap>
                </signed>
              </closer>
            </div>
            <div hand="#print_black_boteandbock" xml:lang="de">
              <ab>
                <lb/>Postscheck Bln W 32 98 &#xB7; <rs type="org" ref="#amp_organization_346">Bank für Handel und Industrie</rs>, <rs type="place" ref="#amp_place_id_17">Berlin</rs> (BLZ 100 800 00) Kto. 618 800 &#xB7; <rs type="org" ref="#amp_organization_347">Berliner Bank</rs>, <rs type="place" ref="#amp_place_id_17">Berlin</rs> (BLZ 100 200 00) Kto. 99/80 410
                <lb/>Postscheck Ffm 772 44 &#xB7; <rs type="org" ref="#amp_organization_348">Dresdner Bank</rs>, <rs type="place" ref="#amp_place_id_292">Wiesbaden</rs> (BLZ 510 800 60) Kto. 115 204 &#xB7; <rs type="org" ref="#amp_organization_349">Nassauische Sparkasse</rs>, <rs type="place" ref="#amp_place_id_292">Wiesbaden</rs> (BLZ 510 500 15) Kto. 111 020 531
              </ab>
            </div>
            </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00494/" ed="1v" type="sheet"/>
