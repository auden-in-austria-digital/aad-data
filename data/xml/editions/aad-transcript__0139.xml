    <body>
      <div type="transcription" xml:id="transcription_aad_0139" xml:lang="de">
        <div type="envelope">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00598/" ed="1r" type="envelope"/>
          <ab hand="#hand_blue_auden">
            <lb/><rs type="person" ref="#amp_person_220">Frau Dokt<unclear>o</unclear>r
            <lb/>Herta. F. Staub</rs>
            <address>
              <lb/><rs type="place" ref="#amp_place_id_417">A-1080 Wien
              <lb/>Schonb<unclear>or</unclear>ngasse 6.</rs>
            </address>   
          </ab>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00599/" ed="1v" type="envelope"/>
          <ab hand="#hand_blue_auden">
            <lb/><rs type="person" ref="#amp_person_1">WH Auden</rs>
          <seg hand="#print_black_auden">
            <address>
              <lb/><rs type="place" ref="#amp_place_id_2">KIRCHSTETTEN, BEZ. ST. PÖLTEN
              <lb/>HINTERHOLZ 6
              <lb/>N.-Ö., <foreign xml:lang="en">AUSTRIA</foreign></rs>
            </address>
            </seg>
            <seg hand="#hand_blue_auden">
              <lb/>3062
            </seg>
          </ab>
          <ab hand="#stamp_gray_wsl">
            <lb/><rs type="org" ref="#amp_organization_240">U. LANDE<gap reason="illegible" unit="char" quantity="1"></gap></rs>
          </ab>
        </div>
        <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00600/" ed="2r" type="sheet"/>
          <div type="letter_message" hand="#hand_blue_auden">
            <opener>
              <dateline>
                <date>
                  <lb/><subst><del rend="overwritten" hand="#hand_blue_auden">6</del><add place="superimposed" hand="#hand_blue_auden"><unclear>O</unclear></add></subst>kt 6<hi rend="superscript">te</hi>
                </date>
                 <seg hand="#print_black_auden">
                  <placeName>
                    <address>
                      <lb/><rs type="place" ref="#amp_place_id_2">3062 KIRCHSTETTEN
                      <lb/>BEZ. ST. PÖLTEN
                      <lb/>HINTERHOLZ 6
                      <lb/>N.-Ö., <foreign xml:lang="en">AUSTRIA</foreign></rs>
                    </address>
                  </placeName>
                </seg>
              </dateline>
              <salute hand="#hand_blue_auden">
                <lb/>Liebe <rs type="person" ref="#amp_person_220">D<hi rend="superscript"><unclear>r.</unclear></hi> Staub</rs><unclear>;</unclear>
              </salute>
            </opener>
              <p>
                <lb/>Viel Dank für d<gap atLeast="1" atMost="2" unit="char" reason="illegible"></gap> <rs ana="#ana_124">Ubers<unclear>a</unclear>tzung</rs>
                <lb/><unclear>da</unclear>s ist zeitlic<unclear>h</unclear> gekommen, weil i<del rend="overstrike" hand="#hand_blue_auden">ch</del>
                <lb/>morgen fahre ich nach <rs type="place" ref="#amp_place_id_239">England</rs><unclear>.</unclear>
              </p>
              <p>
                <lb/>Holfen<unclear>l</unclear>lich sehen uns bald n<unclear>äc</unclear>hste
                <lb/>Jahr.
              </p>
            <closer>
              <salute>
                <lb/>Grüsse
              </salute>
              <signed>
                <lb/><rs type="person" ref="#amp_person_1">W.H. Auden</rs>
              </signed>
            </closer>
          </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00601/" ed="2v" type="sheet"/>
          <div>
          <ab hand="#stamp_gray_wsl">
            <lb/><rs type="org" ref="#amp_organization_240">WI<unclear>E</unclear><gap unit="char" quantity="3" reason="illegible"></gap> STADT- U. LANDES<unclear>BIB</unclear>L</rs> <space quantity="1" unit="char"/>4
          </ab>
          </div>
        </div>
       </div>
