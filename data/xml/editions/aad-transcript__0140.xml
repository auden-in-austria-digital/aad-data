  <text>
    <body>
      <div type="transcription" xml:id="transcription_aad_0140" xml:lang="en">
        <div type="envelope">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00602/" ed="1r" type="envelope"/>
          <ab hand="#hand_blue_auden">
              <lb/><rs type="person" ref="#amp_person_220">Profe<unclear>r</unclear>sor Herta Staub</rs>
            <address>
              <lb/><rs type="place" ref="#amp_place_id_514">1160 <foreign xml:lang="de">Wien</foreign>
              <lb/>Thaliastrasse 149/7</rs>
            </address>   
          </ab>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00603/" ed="1v" type="envelope"/>
          <ab hand="#hand_blue_auden">
              <lb/><rs type="person" ref="#amp_person_1">W.H. Auden</rs>
              <seg hand="#print_black_auden">
              <address>
                <lb/><rs type="place" ref="#amp_place_id_2">3062 KIRCHSTETTEN
                <lb/><foreign xml:lang="de">BEZ.</foreign> ST. PÖLTEN
                <lb/>HINTERHOLZ 6
                <lb/><foreign xml:lang="de">N.-Ö.</foreign>, AUSTRIA</rs>
              </address>
            </seg>
            </ab>
            <ab hand="#stamp_gray_wsl">
              <lb/><rs type="org" ref="#amp_organization_240"><foreign xml:lang="de">WIENER STADT- U. LANDESBIBL.</foreign> <space quantity="1" unit="char"/></rs>4
            </ab>
         </div>
         <div type="letter">
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00604/" ed="2r" type="sheet"/>
           <div type="letter_message" hand="#hand_blue_auden">
             <opener>
               <dateline>
                 <date>
                   <lb/>May 16<hi rend="superscript">th</hi>.
                 </date>
                 <seg hand="#print_black_auden">
                   <placeName>
                     <address>
                         <lb/><rs type="place" ref="#amp_place_id_2">3062 KIRCHSTETTEN
                         <lb/><foreign xml:lang="de">BEZ.</foreign> ST. PÖLTEN
                         <lb/>HINTERHOLZ 6
                         <lb/><foreign xml:lang="de">N.-Ö.</foreign>, AUSTRIA</rs>
                     </address>
                   </placeName>
                 </seg>
               </dateline>
               <salute hand="#hand_blue_auden">
                 <lb/>Dear <rs type="person" ref="#amp_person_220"><subst><del rend="overwritten" hand="#hand_blue_auden">D<hi rend="superscript">r</hi></del><add place="superimposed" hand="#hand_blue_auden">Professo<unclear>r</unclear></add></subst> Staub</rs><unclear>.</unclear>
               </salute>
             </opener>
               <p>
                <lb/>Many thank<unclear>s</unclear> for your letter<unclear>,</unclear>
                <lb/>I sh<unclear>a</unclear>ll be glad to come <unclear>to</unclear> the
                <lb/><rs type="org" ref="#amp_organization_163">Kleine Galerie</rs> o<unclear>n</unclear> <rs type="event" ref="#amp_event_id_119">Tuesday the 25<hi rend="superscript">th</hi></rs>
                <lb/>at 7.30.
              </p>
              <p>
                <lb/>You needn't bother to fetch me. I'll
                <lb/>take a train, and shall stay in
                <lb/><rs type="place" ref="#amp_place_id_1"><foreign xml:lang="de">Wien</foreign></rs> for the night as I li<unclear>ke</unclear> to
                <lb/>get to bed early
             </p>
             <closer>
               <salute>
                 <lb/>your sinc<unclear>er</unclear>ely
               </salute>
               <signed>
                 <lb/><rs type="person" ref="#amp_person_1">W.H. Auden</rs>
               </signed>
             </closer>
           </div>
        <pb facs="https://iiif.acdh.oeaw.ac.at/aad/aad_00605/" ed="2v" type="sheet"/>
           <div>
             <ab hand="#stamp_gray_wsl">
               <lb/><rs type="org" ref="#amp_organization_240"><foreign xml:lang="de">WIENER STADT- U. LANDESBIBL.</foreign></rs> <space quantity="1" unit="char"/>4
             </ab>
           </div>
         </div>
      </div>
    </body>
